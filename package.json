{
  "name": "countdown-timer-app",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "mobile": "yarn workspace @countdown-timer-app/mobile start",
    "web": "yarn workspace @countdown-timer-app/web dev",
    "ios": "yarn workspace @countdown-timer-app/mobile ios",
    "backend": "yarn workspace @countdown-timer-app/backend dev",
    "backend:build": "yarn workspace @countdown-timer-app/backend build",
    "dev": "concurrently \"yarn backend\" \"yarn web\" -n \"backend,web\"",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.1.6",
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  },
  "overrides": {
    "postcss": "^8.5.31",
    "expo": "~54.0.38",
    "@expo/metro-runtime": "~6.1.2",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "react-native": "0.81.6",
    "react-native-web": "~0.21.0"
  },
  "dependencies": {
    "expo": "~54.0.38",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "react-native": "0.81.6",
    "react-native-web": "~0.21.0",
    "@expo/metro-runtime": "~6.1.2"
  }
}
